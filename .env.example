# Path to the Bee CLI (installed with: npm i -g @beeai/cli)
BEE_BIN=bee
# Local Bee API proxy (started automatically if not running)
BEE_PROXY_PORT=8787
# Where Nectar keeps its SQLite database
NECTAR_DB_PATH=./data/nectar.db
# Your timezone, used to resolve "Friday" or "after lunch" (Phase 3)
NECTAR_TIMEZONE=Africa/Monrovia
# Live event source: "cli" (bee stream --json) or "sse" (proxy /v1/stream)
NECTAR_STREAM_MODE=cli
# Event types to subscribe to
NECTAR_STREAM_TYPES=new-utterance,new-conversation,update-conversation,journal-text,todo-created,todo-updated
# Which model API extracts commitments: bedrock (default), anthropic (Anthropic's API directly)
# or openai (any OpenAI-compatible server, e.g. a local Ollama). Per-provider default models:
# bedrock us.anthropic.claude-haiku-4-5-20251001-v1:0, anthropic claude-haiku-4-5, openai llama3.1
NECTAR_PROVIDER=bedrock
# anthropic: ANTHROPIC_API_KEY=...   openai: NECTAR_LLM_BASE_URL=http://localhost:11434/v1 (and NECTAR_LLM_API_KEY if the server needs one)
# Phase 2: Amazon Bedrock (credentials come from your AWS profile, e.g. `aws configure` or AWS_PROFILE)
AWS_REGION=us-east-1
# Default: Claude Haiku 4.5 via US cross-region inference profile.
# Fallback without the Anthropic use-case form: us.amazon.nova-lite-v1:0
NECTAR_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Commitments below this confidence are dropped; between min and open they are "suggested"
NECTAR_MIN_CONFIDENCE=0.4
NECTAR_OPEN_THRESHOLD=0.7
# Silence (ms) before a conversation window is sent to the model
NECTAR_WINDOW_PAUSE_MS=20000
# Set to "off" to run the Phase 1 data layer only
NECTAR_EXTRACTION=on
# Phase 3: to-dos and wrist alarms
NECTAR_CREATE_TODOS=on
# Alarm this many minutes before the due time
NECTAR_ALARM_LEAD_MIN=10
# Untimed promises: due in 2 h during the day; after the cutoff hour, next workday start
NECTAR_WORKDAY_START=9
NECTAR_SAME_DAY_CUTOFF=16
# Evening review (local time, HH:MM) or "off"
NECTAR_REVIEW_TIME=18:00
# Phase 4: pre-meeting recap (open promises to the people you are about to meet)
NECTAR_RECAP=on
NECTAR_RECAP_LEAD_MIN=10
# Re-check Bee's changefeed this often (minutes); the live stream can drop events
NECTAR_CATCHUP_MIN=5
# "debug" for verbose logs and stack traces
NECTAR_LOG_LEVEL=info
