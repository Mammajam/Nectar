{
  "name": "nectar",
  "version": "0.1.0",
  "description": "Ambient commitment agent for Bee wearable AI: spoken promises become wrist alarms.",
  "type": "module",
  "license": "MIT",
  "author": "Mamadou Jam Kromah",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest",
    "check:g0": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/check-g0.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
