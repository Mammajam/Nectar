{
  "name": "nectar",
  "version": "0.4.0",
  "description": "Ambient commitment agent for Bee wearable AI: spoken promises become wrist alarms.",
  "type": "module",
  "license": "MIT",
  "author": "Mamadou Jam Kromah",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest",
    "check:g0": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/check-g0.ts",
    "eval": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/eval-extraction.ts",
    "commitments": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/list-commitments.ts",
    "review": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/review.ts",
    "schedule": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/schedule.ts",
    "test:coverage": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1149.0",
    "@modelcontextprotocol/sdk": "^1.32.1"
  }
}
